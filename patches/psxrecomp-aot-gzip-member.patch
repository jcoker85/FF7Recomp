@@ -28,8 +28,18 @@ Exactly one candidate must exist on the disc being read.
 
 Methods are decoders over bytes only; they never see a path, the disc, or the
 profile's other sections.
+
+    bpe_container   block-wise byte-pair expansion (tools/bpe_container.py)
+    gzip_member     one RFC 1952 gzip member, read to its trailer; the trailer's
+                    CRC-32 and size must match. Whatever follows the member is
+                    not consumed. A loader that frames the stream (for example a
+                    size header before it) is pinned by `words` checks. Optional
+                    `zero_tail` appends that many zero bytes: memory the loader
+                    clears right after the decoded image (a BSS fill), declared
+                    only as far as code reaches into it (a final delay slot).
 """
 import hashlib
+import zlib
 
 import bpe_container
 
@@ -46,9 +56,24 @@ def _bpe_container(data, spec):
     return bpe_container.decode(data, magic=number(spec['magic']), offset=0)
 
 
+def _gzip_member(data, spec):
+    inflater = zlib.decompressobj(zlib.MAX_WBITS | 16)
+    try:
+        output = inflater.decompress(data)
+    except zlib.error as exc:
+        raise ValueError(f'gzip: {exc}') from exc
+    if not inflater.eof:
+        raise ValueError('gzip member is truncated')
+    zero_tail = number(spec.get('zero_tail', 0))
+    if zero_tail < 0 or zero_tail % 4:
+        raise ValueError('zero_tail must be a non-negative multiple of 4')
+    return output + bytes(zero_tail), len(data) - len(inflater.unused_data)
+
+
 # method -> (decoder(data_from_source_offset, spec) -> (output, consumed),
 #            keys the spec must declare beyond the common ones)
-METHODS = {'bpe_container': (_bpe_container, ('magic',))}
+METHODS = {'bpe_container': (_bpe_container, ('magic',)),
+           'gzip_member': (_gzip_member, ())}
 COMMON_KEYS = ('name', 'method', 'source', 'consumed', 'source_sha256', 'size', 'sha256')
 
 
