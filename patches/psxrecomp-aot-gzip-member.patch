+    def test_gzip_member_decodes_one_framed_member_and_fails_closed(self):
+        member = gzip.compress(self.OVERLAY, mtime=0)
+        # A loader header before the member and unrelated bytes after it.
+        packed = struct.pack('<II', len(self.OVERLAY), 0x40) + member + b'\0\0\0\0'
+        spec = dict(name='PREPARED/OVERLAY', method='gzip_member',
+                    source=dict(file='MODULE.BIN', file_offset=8), consumed=len(member),
+                    source_sha256=sha(member), size=len(self.OVERLAY), sha256=sha(self.OVERLAY))
+        view = prepared_files.prepare(FakeDisc({'MODULE.BIN': packed}), dict(prepared_files=[spec]))
+        self.assertEqual(view.read('PREPARED/OVERLAY'), self.OVERLAY)
+        tail = dict(spec, zero_tail='0x4', size=len(self.OVERLAY) + 4, sha256=sha(self.OVERLAY + bytes(4)))
+        view = prepared_files.prepare(FakeDisc({'MODULE.BIN': packed}), dict(prepared_files=[tail]))
+        self.assertEqual(view.read('PREPARED/OVERLAY'), self.OVERLAY + bytes(4))
+        with self.assertRaisesRegex(prepared_files.PreparedError, 'zero_tail'):
+            prepared_files.prepare(FakeDisc({'MODULE.BIN': packed}),
+                                   dict(prepared_files=[dict(tail, zero_tail=2)]))
+        corrupt = bytearray(packed)
+        corrupt[-8] ^= 1                    # inside the member's CRC-32
+        cases = [(FakeDisc({'MODULE.BIN': packed[:-12]}), 'truncated'),
+                 (FakeDisc({'MODULE.BIN': bytes(corrupt)}), 'does not decode'),
+                 (FakeDisc({'MODULE.BIN': b'\0' * 8 + self.OVERLAY}), 'does not decode')]
+        for disc, error in cases:
+            with self.subTest(error=error), self.assertRaisesRegex(prepared_files.PreparedError, error):
+                prepared_files.prepare(disc, dict(prepared_files=[spec]))
+
