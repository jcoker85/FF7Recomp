+void mod_runtime_apply_fps_mode(int fps) {
+    RuntimeMods& s = state();
+    if (!s.initialized) return;
+    const bool want = fps == 30;
+    std::vector<std::string> ids;
+    for (const auto& entry : s.manager.packages()) ids.push_back(entry.first);
+    for (const std::string& id : ids) {
+        if (!s.manager.selected_feature(id, "fps_mode")) continue;
+        std::string err;
+        const bool ok = s.manager.set_feature_enabled(id, "fps_mode", want, &err);
+        s.ticket_ready = false;
+        if (ok)
+            std::fprintf(stdout, "psxrecomp: FPS mode %s (%s)\n",
+                         want ? "target 30" : "original", id.c_str());
+        else
+            std::fprintf(stderr, "psxrecomp: cannot set FPS mode on %s: %s\n",
+                         id.c_str(), err.c_str());
+    }
+}
