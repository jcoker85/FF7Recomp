+/* Settings.dithering: 1 On -> 2 Fine -> 0 Off -> 1 On. */
+void launcher_model_cycle_dithering(LauncherModel* m) {
+    if (!m || !m->has_dithering) return;
+    m->s.dithering = m->s.dithering == 1 ? 2 : m->s.dithering == 2 ? 0 : 1;
+}
+
+const char* launcher_model_dithering_label(const LauncherModel* m) {
+    switch (m->s.dithering) {
+        case 0:  return "Off";
+        case 2:  return "Fine";
+        default: return "On";
+    }
+}
